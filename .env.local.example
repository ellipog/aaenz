# Resend — contact form delivery (https://resend.com/api-keys)
# Create a key and paste it here, then rename this file to `.env.local`.
RESEND_API_KEY=re_xxxxxxxxxx

# The address contact form submissions are delivered to (server-side, secret).
CONTACT_TO_EMAIL=elliot@aaenz.no

# Same address, exposed to the client so it renders in the footer & CTA too.
# Keep these two in sync — change it here and it updates everywhere.
NEXT_PUBLIC_CONTACT_EMAIL=elliot@aaenz.no

# The verified sending address (Resend requires a verified domain).
# yomion.com is the domain currently verified in Resend.
CONTACT_FROM_EMAIL=aaenz studios <aaenstudios@yomion.com>
